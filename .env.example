# Google Workspace SMTP fuer das Buchungsformular
# Kopiere diese Datei nach `.env` und trage die echten Werte ein.
# SMTP_PASS = Google App-Passwort (NICHT das normale Login-Passwort).
# App-Passwort erstellen: https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@el-capitan.net
SMTP_PASS=xxxx xxxx xxxx xxxx

# Empfaenger der Buchungsanfragen + Absenderadresse
MAIL_TO=info@el-capitan.net
MAIL_FROM=info@el-capitan.net

# Optionale BCC-Adresse(n), kommagetrennt (leer lassen = keine BCC)
MAIL_BCC=
