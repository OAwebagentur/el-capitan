# SMTP/IMAP-Postfach fuer das Buchungsformular
# Kopiere diese Datei nach `.env` und trage die echten Werte ein.
# Bei Google Workspace ist SMTP_PASS ein App-Passwort (NICHT das Login-Passwort):
# https://myaccount.google.com/apppasswords

SMTP_HOST=smtp.example.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=postfach@example.net
SMTP_PASS=xxxxxxxxxxxx

# Empfaenger der Buchungsanfragen + Absenderadresse
# MAIL_FROM muss zum SMTP-Login gehoeren (Konto oder erlaubter Alias),
# sonst weist der Mailserver den Versand ab bzw. die Mail landet im Spam.
MAIL_TO=info@el-capitan.net
MAIL_FROM=postfach@example.net

# Optionale BCC-Adresse(n), kommagetrennt (leer lassen = keine BCC)
MAIL_BCC=

# IMAP: Kopie der versendeten Mail im Gesendet-Ordner ablegen.
# Host/Port/User/Pass sind optional – ohne Angabe werden die SMTP-Werte
# genutzt (gleiches Postfach, Port 993). Der Gesendet-Ordner wird per
# SPECIAL-USE (\Sent) bzw. ueblichen Namen automatisch erkannt.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
# Nur setzen, wenn die Auto-Erkennung scheitert (z. B. INBOX.Gesendet)
IMAP_SENT_MAILBOX=
# Ablage abschalten: false
IMAP_APPEND_SENT=true
